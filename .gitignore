# Build output from the deleted Rust service, in case a stale checkout
# still has it. Nothing in this repository produces it any more.
/target/

# The legacy apps/web interface: retired in WS-0021@4; leftovers from older
# checkouts (dist/, node_modules/).
/apps/web/

# Local databases and runtime state
node_modules/
/.preview/
/.alchemy/bundles/
dev/.wrangler/
*.db
*.db-shm
*.db-wal
.env
.env.*
!.env.example

# Generated evidence and raw payloads
/evidence/generated/
/research/raw/

# Editors and operating systems
.DS_Store
.idea/
.vscode/

# Cloudflare and generated deployment state. Alchemy state is local mutable
# provider state and can contain resolved secret bindings, so it is never
# repository evidence.
/infra/.alchemy/
/node_modules/
/.wrangler/
/.artifacts/
.tools/
/.serena/

# Idempotent deployment state generated from the source template
/wrangler.*.deploy.jsonc
/.deploy/

# Local Wrangler secrets generated by setup
/.dev.vars
/.dev.vars.*

# Locally generated client credentials
/.principal.env
/.principal.*.env

# Python caches
__pycache__/
*.pyc

# Generated test artefacts
/coverage/

# Tag-pinned Foldkit source fetched by scripts/setup.sh (WS-0026)
/repos/

# devenv shell state and per-machine overrides (WS-0027@2), and the Vite+ hook
# dispatcher that `vp config` generates under .vite-hooks/_.
.devenv*
devenv.local.nix
/.vite-hooks/_/

# The index client build (WS-0025): generated by scripts/build-index-web.sh.
/apps/index-web/dist/

# Playwright run output (vp run e2e).
/test-results/
/playwright-report/
