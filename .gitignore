# Rust
/target/

# Local databases and runtime state
node_modules/
/.preview/
/.alchemy/bundles/
dev/.wrangler/
*.db
*.db-shm
*.db-wal
.env
.env.*
!.env.example

# Generated evidence and raw payloads
/evidence/generated/
/research/raw/

# Editors and operating systems
.DS_Store
.idea/
.vscode/

# Cloudflare and generated deployment state
#
# infra/.alchemy/state IS tracked, deliberately: it is the only record of which
# cloud resources exist, and losing it means Alchemy forgets a deployed Worker
# and D1 rather than being able to update or destroy them. The log beside it is
# noise and is not.
/infra/.alchemy/log/
/node_modules/
/.wrangler/
/.artifacts/
/crates/job-index-worker/build/
.tools/

# Idempotent deployment state generated from the source template
/wrangler.*.deploy.jsonc
/.deploy/

# Local Wrangler secrets generated by setup
/.dev.vars
/.dev.vars.*

# Locally generated client credentials
/.principal.env
/.principal.*.env

# Python caches
__pycache__/
*.pyc

# Generated test artefacts
/coverage/
