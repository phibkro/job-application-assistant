{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "no-console": "error",
    "eqeqeq": "error",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "no-underscore-dangle": [
      "error",
      {
        "allow": [
          "_tag"
        ]
      }
    ]
  },
  "ignorePatterns": [
    "node_modules",
    "infra/node_modules",
    "target",
    ".wrangler",
    ".artifacts",
    "crates"
  ],
  "overrides": [
    {
      "files": [
        "packages/domain/**/*.ts"
      ],
      "rules": {
        "effect/no-ambient-authority": [
          "error",
          {
            "technology": "effect-v4",
            "role": "pure-library",
            "platform": "portable"
          }
        ]
      }
    },
    {
      "files": [
        "apps/worker/src/**/*.ts",
        "packages/adapters/**/*.ts"
      ],
      "rules": {
        "effect/no-ambient-authority": [
          "error",
          {
            "technology": "effect-v4",
            "role": "service",
            "platform": "portable"
          }
        ]
      }
    },
    {
      "files": [
        "**/*.test.ts"
      ],
      "rules": {
        "effect/no-ambient-authority": "off"
      }
    },
    {
      "files": [
        "apps/worker/src/runtime/**/*.ts",
        "apps/worker/src/index.ts",
        "apps/worker/src/ingestion/SourceLeaseObject.ts",
        "apps/worker/src/accounts/hash.ts",
        "apps/worker/src/db/{FakeD1,Sqlite}.ts",
        "apps/worker/src/testSupport/**/*.ts"
      ],
      "rules": {
        "effect/no-ambient-authority": "off"
      }
    },
    {
      "files": [
        "apps/web/**/*.ts"
      ],
      "rules": {
        "effect/no-ambient-authority": "off"
      }
    }
  ],
  "jsPlugins": [
    {
      "name": "effect",
      "specifier": "@phibkro/oxlint-effect-plugin"
    }
  ]
}
