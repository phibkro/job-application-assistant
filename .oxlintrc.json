{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "no-console": "error",
    "eqeqeq": "error",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "no-underscore-dangle": [
      "error",
      {
        "allow": [
          "_tag"
        ]
      }
    ]
  },
  "ignorePatterns": [
    "node_modules",
    "infra/node_modules",
    "target",
    ".wrangler",
    ".artifacts",
    "crates"
  ]
}
