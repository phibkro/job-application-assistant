{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/work-scope.schema.json",
  "title": "WorkScope",
  "type": "object",
  "required": [
    "id",
    "revision",
    "goal",
    "acceptance_criteria",
    "exclusions",
    "risk_tier",
    "owner"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_tier": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "repository_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempt_budget": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": true
}
