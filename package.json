{
  "name": "@job-index/root",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt packages apps",
    "fmt:check": "oxfmt --check packages apps",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:workers": "nix shell nixpkgs#nodejs -c node node_modules/.bin/vitest run -c vitest.workers.config.ts",
    "test:all": "bun run test && bun run test:workers",
    "coverage": "vitest run --coverage",
    "coverage:workers": "nix shell nixpkgs#nodejs -c node node_modules/.bin/vitest run -c vitest.workers.config.ts --coverage",
    "coverage:all": "bun run coverage && bun run coverage:workers",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "check": "bun run fmt:check && bun run lint && bun run imports:check && bun run typecheck && bun run schema:check && bun run catalog:check && bun run bundle:check && bun run coverage:all",
    "schema": "bun run scripts/ts/schema.ts --emit",
    "schema:check": "bun run scripts/ts/schema.ts",
    "bundle:check": "bun build apps/worker/src/index.ts --target=browser --conditions=workerd --conditions=worker --external \"cloudflare:*\" > /dev/null",
    "imports:check": "bun run scripts/ts/tracked-imports.ts",
    "catalog": "bun run scripts/ts/catalog.ts --emit",
    "catalog:check": "bun run scripts/ts/catalog.ts"
  },
  "dependencies": {
    "effect": "4.0.0-rc.108"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@phibkro/oxlint-effect-plugin": "^0.1.0",
    "@playwright/test": "1.61.1",
    "@types/node": "^22",
    "@vitest/coverage-istanbul": "^4.1.10",
    "fast-check": "^4.9.0",
    "oxfmt": "0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
