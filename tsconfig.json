{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@job-index/domain/*": [
        "packages/domain/src/*"
      ],
      "@job-index/worker/*": [
        "apps/worker/src/*"
      ],
      "@job-index/adapters/nav": [
        "packages/adapters/nav/src/index.ts"
      ],
      "@job-index/adapters/jsonld": [
        "packages/adapters/jsonld/src/index.ts"
      ],
      "@job-index/adapters/shared/*": [
        "packages/adapters/shared/src/*"
      ],
      "@job-index/adapters/*": [
        "packages/adapters/src/*"
      ]
    },
    "types": [
      "node",
      "vitest/importMeta",
      "@cloudflare/vitest-pool-workers/types"
    ]
  },
  "include": [
    "packages/**/*.ts",
    "apps/**/*.ts"
  ]
}
