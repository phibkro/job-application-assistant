{
  // Local preview of the TypeScript service: the Worker serving the API, with
  // the built interface beside it as static assets. Not a deploy target —
  // infra/alchemy.run.ts owns staging and production, and still points at the
  // Rust worker until cutover.
  "name": "job-index-preview",
  "main": "../.preview/worker.js",
  "compatibility_date": "2026-05-25",
  "vars": { "ENVIRONMENT": "local" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "job-index-preview",
      "database_id": "local",
      "migrations_dir": "../db/migrations",
    },
  ],
  // One Durable Object per source, admitting one `Ingestion.collect` run at
  // a time for it. `class_name` must match what `apps/worker/src/index.ts`
  // exports — Cloudflare finds the class by name against the bundled main
  // module, not by any binding key.
  "durable_objects": {
    "bindings": [{ "name": "SOURCE_LEASE", "class_name": "SourceLeaseObject" }],
  },
  // Wrangler requires an explicit migration the first time a Durable Object
  // class appears — `infra/alchemy.run.ts` computes the equivalent
  // automatically by diffing its own state, but this file is hand-maintained
  // local config, so it is declared here directly.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SourceLeaseObject"] }],
  "assets": {
    "directory": "../apps/web/dist",
    "binding": "ASSETS",
    // The interface routes client-side, so a deep link must reach it rather
    // than 404 on a file that was never written.
    "not_found_handling": "single-page-application",
    // API requests and Wrangler's local scheduled-event probe must reach the
    // Worker before the single-page application fallback.
    "run_worker_first": ["/api/*", "/__scheduled*"],
  },
}
