{
  "name": "job-index-production",
  "main": "crates/job-index-worker/build/index.js",
  "compatibility_date": "2026-05-25",
  "workers_dev": true,
  "build": {
    "command": "cd crates/job-index-worker && worker-build --release"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "SOURCE_CODE_URL": "",
    "ALLOW_DEMO_MUTATIONS": "false",
    "ALLOW_NAV_SYNC_WITHOUT_TOKEN": "false",
    "NAV_USE_PUBLIC_TOKEN": "false",
    "NAV_SYNC_ENABLED": "true",
    "NAV_DETAIL_FETCH_LIMIT": "40",
    "NAV_MAX_PAGES_PER_RUN": "4",
    "NAV_MAX_OBSERVATIONS_PER_RUN": "600",
    "NAV_MAX_DURATION_MS": "20000",
    "NAV_LEASE_TTL_MS": "90000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": [
      "0,15,30,45 * * * *",
      "2,7,12,17,22,27,32,37,42,47,52,57 * * * *",
      "4,9,14,19,24,29,34,39,44,49,54,59 * * * *"
    ]
  }
}
